# ─── 依赖 ───
node_modules/

# ─── 便携 Node.js 运行时（scripts/ensure-node.bat 自动下载，不进 git） ───
runtime/

# ─── 敏感配置（含真实 API Key / 密码，勿提交） ───
# 请复制 config/default.example.json 为 config/default.json 后自行填写
config/default.json

# ─── 敏感词库（含涉政等敏感内容，需自行维护，勿提交） ───
data/sensitive_words.json
data/sensitive_words.json.bak
data/builtin-patterns.json
data/*.bak

# ─── 调试残留 ───
.probe-cwd.txt

# ─── 运行时数据（审核记录、对比结果） ───
data/batch_results/
data/audit_records/
data/comparisons/
data/batch_tasks/
data/export_jobs/
data/plugins-tmp/
data/plugin-config.json
data/plugins-state.json

# ─── 日志 ───
logs/
*.log

# ─── 本地 GGUF 模型（大文件） ───
models/

# ─── WorkBuddy 项目数据 ───
.workbuddy/

# ─── 重构前安全备份（体积大，仅供本地回滚） ───
.backup/

# ─── 系统文件 ───
desktop.ini
.DS_Store
Thumbs.db

# ─── Windows 保留名垃圾文件 ───
nul

# ─── 环境变量 ───
.env
.env.local
builds/
